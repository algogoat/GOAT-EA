    {"change": "boos_loss_leg", "plain": "The same at set level.", "v1_case": "boos_loss_4_windows_set_v1", "v1_expected": "fail", "v2_case": "boos_loss_4_windows_set_v2", "v2_expected": "pass"},
    {"change": "in_sample_base", "plain": "A FOOS drawdown above 1.5 x SAMPLE's but within 1.5 x SAMPLE+FWD's: version 1 fails it, version 2 passes it.", "v1_case": "foos_dd_between_the_bars_v1", "v1_expected": "fail", "v2_case": "foos_dd_between_the_bars_v2", "v2_expected": "pass"},
    {"change": "in_sample_base", "plain": "The same at set level.", "v1_case": "foos_dd_between_the_bars_set_v1", "v1_expected": "fail", "v2_case": "foos_dd_between_the_bars_set_v2", "v2_expected": "pass"}

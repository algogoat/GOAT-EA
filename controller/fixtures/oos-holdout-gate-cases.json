{
  "schema": "goat-oos-holdout-gate-cases-v1",
  "source_of_truth": "GOAT-EA controller/studio_oos_windows.py (Claude-Mac ruling, algogoat/goatai#1885 comment 6005864453)",
  "sync": "One file, two byte-identical copies: GOAT-EA controller/fixtures/oos-holdout-gate-cases.json and goatai docs/fixtures/oos-holdout-gate-cases.json. Change it in GOAT-EA first (controller/test_studio_oos_windows.py runs every case and checks rules against the module constants), then copy the same bytes to goatai (its desktop gate test runs every case). Never edit one copy alone; a new case is added to both in the same pair of PRs.",
  "rules": {
    "fractions_of_o": {"boos": "1/3", "sample": "2/3", "fwd": "1/3", "foos": "1/4"},
    "rule_versions": [1, 2],
    "current_rule_version": 2,
    "rule_version": "Every case names the rule version it is judged under (rule_version). Version 2 is the current rule (Claude-Mac, algogoat/goatai#2750 comment 6787022949, 2026-11-11). Version 1 is the rule before it: its cases stay, so every verdict stored under version 1 remains reproducible. A case that names no rule_version is a version 1 case.",
    "in_sample_base": {"1": "SAMPLE (in_sample_max_drawdown)", "2": "SAMPLE+FWD (optimization_max_drawdown)"},
    "min_in_sample_windows_for_loss_leg": 10,
    "boos_gate": "Lenient 'not broken' gate (Vince, locked 2026-10-11): with the 30-trade floor met, BOOS fails only on max_drawdown above 1.5 x in-sample, or on a loss (pl < 0) below in_sample_p10_pl. No PF or profit bar for BOOS; FOOS keeps PF >= 1.0 and the DD bar. Version 2: the loss leg applies only when in_sample_windows is at least 10; with fewer, a BOOS loss alone does not fail (the drawdown leg still judges it), and a BOOS loss with an unknown window count is not_measured. Version 1: the loss leg applies at every window count.",
    "min_trades": 30,
    "min_pf": 1.0,
    "max_dd_multiple_of_in_sample": 1.5,
    "statuses": ["pass", "fail", "not_eligible_yet", "no_data", "not_measured"],
    "set_order": ["fail", "not_eligible_yet", "not_measured", "no_data", "pass"]
  },
  "definitions": {
    "rule_version": "1 or 2: the rule the case is judged under; absent = 1.",
    "trades": "Positions opened in the window (entry deals inside it); the EA's Trades= header count.",
    "pl": "Net of profit + swap + commission + fee over the deals inside the window of the positions opened in it.",
    "pf": "Positive deal results / |non-positive deal results| of those deals. PF >= 1.0 is exactly pl >= 0; a case may give pf, pl or both (consistent).",
    "max_drawdown": "Equity (not balance) drawdown in money: deepest fall of the sampled equity below its running peak, the peak starting at the window's opening equity. Same definition for SAMPLE, SAMPLE+FWD, BOOS and FOOS.",
    "in_sample_max_drawdown": "max_drawdown of SAMPLE: the in-sample drawdown of rule version 1. 0 or null leaves no limit (not_measured). A version 2 case never reads it.",
    "optimization_max_drawdown": "max_drawdown over SAMPLE and FWD together, from SAMPLE's first day through FWD's last day (the whole O span, the drawdown the selection saw), the peak starting at that span's opening equity: the in-sample drawdown of rule version 2. 0 or null leaves no limit (not_measured). A version 1 case never reads it.",
    "in_sample_p10_pl": "The 10th percentile (linear interpolation, numpy 'linear' / Excel PERCENTILE.INC) of the pl of every window of BOOS's own length inside SAMPLE, starting at SAMPLE's first day and stepping one week. Null: a BOOS loss the loss leg applies to cannot be judged (not_measured).",
    "in_sample_windows": "How many rolling SAMPLE windows of BOOS's own length in_sample_p10_pl was taken over (SAMPLE weeks - BOOS weeks + 1: 4, 9, 17 and 35 at O = 3, 6, 12 and 24 months). Version 2 applies the BOOS loss leg only at 10 or more; null or absent: unknown, so a BOOS loss is not_measured. Version 1 does not read it.",
    "complete": "false while the window has not been tested through its last day (FOOS: the export Friday); null/absent = complete.",
    "present": "false when the set has no such window; a null window means the same."
  },
  "rule_change_proofs": [

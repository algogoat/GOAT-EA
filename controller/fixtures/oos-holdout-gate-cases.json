{
  "schema": "goat-oos-holdout-gate-cases-v1",
  "source_of_truth": "GOAT-EA controller/studio_oos_windows.py (Claude-Mac ruling, algogoat/goatai#1885 comment 6005864453)",
  "sync": "One file, two byte-identical copies: GOAT-EA controller/fixtures/oos-holdout-gate-cases.json and goatai docs/fixtures/oos-holdout-gate-cases.json. Change it in GOAT-EA first (controller/test_studio_oos_windows.py runs every case and checks rules against the module constants), then copy the same bytes to goatai (its desktop gate test runs every case). Never edit one copy alone; a new case is added to both in the same pair of PRs.",
  "rules": {
    "fractions_of_o": {"boos": "1/2", "sample": "2/3", "fwd": "1/3", "foos": "1/4"},
    "min_trades": 30,
    "min_pf": 1.0,
    "max_dd_multiple_of_in_sample": 1.5,
    "statuses": ["pass", "fail", "not_eligible_yet", "no_data", "not_measured"],
    "set_order": ["fail", "not_eligible_yet", "not_measured", "no_data", "pass"]
  },
  "definitions": {
    "trades": "Positions opened in the window (entry deals inside it); the EA's Trades= header count.",
    "pl": "Net of profit + swap + commission + fee over the deals inside the window of the positions opened in it.",
    "pf": "Positive deal results / |non-positive deal results| of those deals. PF >= 1.0 is exactly pl >= 0; a case may give pf, pl or both (consistent).",
    "max_drawdown": "Equity (not balance) drawdown in money: deepest fall of the sampled equity below its running peak, the peak starting at the window's opening equity. Same definition for SAMPLE, BOOS and FOOS.",
    "in_sample_max_drawdown": "max_drawdown of SAMPLE. 0 or null leaves no limit (not_measured).",
    "complete": "false while the window has not been tested through its last day (FOOS: the export Friday); null/absent = complete.",
    "present": "false when the set has no such window; a null window means the same."
  },

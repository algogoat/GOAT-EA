{
 "about": "B54 PR A synthetic axis SETs (PR B: ORB_Breakout has its term, so no probe ends at a not-built refusal) (Claude-Mac, GOAT-EA#303 condition 4). Not pool files. Each is a complete SET at the schema's defaults plus base and lines; probes: the SET's values (current), then each Y axis at its start and stop with the others at their values; ladder: every rung (controller only). Read by controller/test_b54_init.py and scripts/test_b54_init.cjs.",
 "base": {
  "Engine_Mode": "1",
  "Single_SL_ATR": "1.0",
  "Mode_Bias_Exit": "0"
 },
 "alerts": {
  "BRK_WITHOUT_SINGLE": "Initialization Failed: BRK_Mode needs the single-trade engine (Engine_Mode=Engine_Single).",
  "ORB_WITHOUT_SINGLE": "Initialization Failed: ORB_Mode needs the single-trade engine (Engine_Mode=Engine_Single).",
  "BRK_WITH_ORB": "Initialization Failed: BRK_Mode and ORB_Mode cannot both be on (one breakout family per SET).",
  "BRK_BARS_RANGE": "Initialization Failed: BRK_Bars must be between 2 and 500 with BRK_Mode=BRK_NBar.",
  "BRK_BUFFER_RANGE": "Initialization Failed: BRK_Buffer_ATR must be between 0 and 5.",
  "BRK_PRIOR_DAY_ON_D1": "Initialization Failed: BRK_Mode=BRK_PriorDay needs a trigger timeframe below D1 (BRK_TF_=TF_D1 is the prior day's own timeframe).",
  "ORB_TF_NOT_M1_TO_H1": "Initialization Failed: ORB_TF_ must be TF_M1, TF_M5, TF_M15 or TF_H1 (the range is counted in its minutes).",
  "ORB_START_RANGE": "Initialization Failed: ORB_Start_Minute must be between 0 and Lim-5 (Lim is 1020 under ORB_Clock_NewYork, 1260 under ORB_Clock_London) and a multiple of ORB_TF_'s minutes.",
  "ORB_RANGE_MINUTES": "Initialization Failed: ORB_Range_Minutes must be between 5 and 240, a multiple of ORB_TF_'s minutes, and end before Lim (ORB_Start_Minute+ORB_Range_Minutes < Lim).",
  "ORB_ENTRY_WINDOW": "Initialization Failed: ORB_Entry_Minutes must be between 0 and Lim, and the entry window must end by Lim (ORB_Start_Minute+ORB_Range_Minutes+ORB_Entry_Minutes <= Lim).",
  "ORB_BUFFER_RANGE": "Initialization Failed: ORB_Buffer_ATR must be between 0 and 5.",
  "ORB_RANGE_FILTER_NEGATIVE": "Initialization Failed: ORB_Min_Range_ATR and ORB_Max_Range_ATR cannot be negative (0 = off).",
  "ORB_RANGE_FILTER_ORDER": "Initialization Failed: ORB_Max_Range_ATR must be above ORB_Min_Range_ATR when both are on."
 },

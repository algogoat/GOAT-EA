{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goatedge.ai/schemas/goat-state-v1.json",
  "title": "GOAT EA typed intelligence state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "stateId", "thesisId", "revision", "assetCanonical",
    "marketAsOf", "publishedAt", "validFrom", "validUntil", "era", "regime",
    "pBull", "pNeutral", "pBear", "actionability", "signedScore",
    "locationState", "triggerType", "thesisStatus", "referencePrice",
    "referencePriceTs", "referenceAtr", "forecastHorizon", "qualityFlags",
    "modelVersion", "analystVersion", "contentHash"
  ],
  "properties": {
    "schemaVersion": {"const": "goat-state-v1"},
    "stateId": {"type": "string", "minLength": 1},
    "thesisId": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 0},
    "assetCanonical": {"type": "string", "minLength": 1},
    "marketAsOf": {"type": "string", "format": "date-time"},
    "publishedAt": {"type": "string", "format": "date-time"},
    "validFrom": {"type": "string", "format": "date-time"},
    "validUntil": {"type": "string", "format": "date-time"},
    "era": {"type": "string"},
    "regime": {"enum": ["STRONG_BEARISH", "BEARISH", "NEUTRAL", "BULLISH", "STRONG_BULLISH"]},
    "pBull": {"type": "number", "minimum": 0, "maximum": 1},
    "pNeutral": {"type": "number", "minimum": 0, "maximum": 1},
    "pBear": {"type": "number", "minimum": 0, "maximum": 1},
    "actionability": {"type": "string"},
    "signedScore": {"type": "number", "minimum": -100, "maximum": 100},
    "locationState": {"enum": ["ENTER_NOW", "WAIT_PULLBACK", "WAIT_CONFIRM", "RANGE_EDGE_ONLY", "NO_TRADE"]},
    "zoneLo": {"type": ["number", "null"]},
    "zoneHi": {"type": ["number", "null"]},
    "triggerType": {"enum": ["IMMEDIATE", "ZONE_TOUCH", "CONFIRMATION"]},
    "entryInvalidation": {"type": ["number", "null"]},
    "eaeAtr": {"type": ["number", "null"]},
    "eaeMinutes": {"type": ["number", "null"]},
    "eaeQuantile": {"type": ["number", "null"]},
    "objective": {"type": ["number", "null"]},
    "thesisStatus": {"enum": ["CONTINUE", "WEAKEN", "NEUTRALIZE", "REVERSE"]},
    "referencePrice": {"type": "number"},
    "referencePriceTs": {"type": "string", "format": "date-time"},
    "referenceAtr": {"type": "number", "exclusiveMinimum": 0},
    "forecastHorizon": {"type": "string"},
    "qualityFlags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "modelVersion": {"type": "string"},
    "analystVersion": {"type": "string"},
    "contentHash": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}
  }
}

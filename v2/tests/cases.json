        "PeakSmart profitable-excess release and cap"
      ]
    },
    {
      "id": "identity_magic_contract",
      "covers": [
        "stable SHA-256-derived identities",
        "53-bit magic ceiling",
        "decimal string transport",
        "collision detection",
        "persisted ordinal requirement"
      ]
    },
    {
      "id": "default_input_gates",
      "covers": [
        "manage-only default",
        "new-risk disabled default",
        "Phase-2 and Phase-3 influence gates"
      ]
    },
    {
      "id": "certification_bookkeeping_contract",
